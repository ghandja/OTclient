Module
  name: gamelib
  description: Contains game related classes
  author: OTClient team
  website: https://github.com/Jattartajjar/CrystalOTC

  @onLoad: |
    dofile 'const'
    dofile 'util'
    dofile 'protocol'
    dofile 'protocolgame'
    dofile 'position'
    dofile 'game'
    dofile 'creature'
    dofile 'creature_list'
    dofile 'player'
    dofile 'market'
    dofile 'textmessages'
    dofile 'thing'
    dofile 'spells'
    dofile 'tile'
    dofile 'items'
    dofiles 'ui'
    dofile 'engine_compat'
