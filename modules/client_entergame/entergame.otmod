Module
  name: client_entergame
  description: Manages enter game and character list windows
  author: edubart
  website: https://github.com/Jattartajjar/CrystalOTC

  dependencies:
    - game_features
    - game_things

  scripts: [ entergame, characterlist, createAccount ]

  @onLoad: |
    EnterGame.init()
    CharacterList.init()

  @onUnload: |
    EnterGame.terminate()
    CharacterList.terminate()
