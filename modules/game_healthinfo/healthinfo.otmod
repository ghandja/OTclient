Module
  name: game_healthinfo
  description: Displays health, mana points, soul points, and conditions
  author: edubart, BeniS
  website: https://github.com/Jattartajjar/CrystalOTC
  sandboxed: true
  scripts: [ healthinfo ]
  @onLoad: healthManaController:init()
  @onUnload: healthManaController:terminate()
