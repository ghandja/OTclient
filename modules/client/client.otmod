Module
  name: client
  description: Initialize the client and setups its main window
  author: edubart
  website: https://github.com/Jattartajjar/CrystalOTC
  reloadable: false
  sandboxed: true
  scripts: [ client ]
  @onLoad: init()
  @onUnload: terminate()

  load-later:
    - client_styles
    - client_topmenu
    - client_bottommenu
    - client_background
    - client_options
    - client_entergame
